{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nguven:schema:text-finetuning-record:v1",
  "title": "N-Güven Text Fine-tuning Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "text",
    "label",
    "labelId",
    "split",
    "preprocessingVersion",
    "inputContentHash",
    "outputContentHash"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "text": {"type": "string", "minLength": 1},
    "label": {"enum": ["human", "synthetic"]},
    "labelId": {"type": "integer", "enum": [0, 1]},
    "split": {"enum": ["train", "validation", "test"]},
    "preprocessingVersion": {"const": "tr-text-v1"},
    "inputContentHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "outputContentHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
