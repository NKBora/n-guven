{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nguven:schema:text-finetuning-plan:v1",
  "title": "N-Güven Text Fine-tuning Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "dataset",
    "candidates",
    "protocol"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "planId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "manifestSha256",
        "preprocessedSha256",
        "ontologyVersion",
        "preprocessingVersion"
      ],
      "properties": {
        "version": {"type": "string", "minLength": 1, "maxLength": 256},
        "manifestSha256": {"$ref": "#/$defs/sha256"},
        "preprocessedSha256": {"$ref": "#/$defs/sha256"},
        "ontologyVersion": {"const": "text-origin-v1"},
        "preprocessingVersion": {"const": "tr-text-v1"}
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapterId", "repository", "revision"],
        "properties": {
          "adapterId": {"enum": ["berturk", "modernbert-tr"]},
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seeds",
        "epochs",
        "trainBatchSize",
        "evaluationBatchSize",
        "learningRate",
        "weightDecay",
        "warmupRatio",
        "maxSequenceLength",
        "earlyStoppingPatience",
        "metricForBestModel",
        "greaterIsBetter",
        "loadBestModelAtEnd",
        "saveFormat",
        "testSplitPolicy"
      ],
      "properties": {
        "seeds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 2147483647}
        },
        "epochs": {"type": "integer", "minimum": 1, "maximum": 100},
        "trainBatchSize": {"type": "integer", "minimum": 1, "maximum": 1024},
        "evaluationBatchSize": {"type": "integer", "minimum": 1, "maximum": 4096},
        "learningRate": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "weightDecay": {"type": "number", "minimum": 0, "maximum": 1},
        "warmupRatio": {"type": "number", "minimum": 0, "maximum": 1},
        "maxSequenceLength": {"type": "integer", "minimum": 8, "maximum": 512},
        "earlyStoppingPatience": {"type": "integer", "minimum": 1, "maximum": 100},
        "metricForBestModel": {"const": "macroF1"},
        "greaterIsBetter": {"const": true},
        "loadBestModelAtEnd": {"const": true},
        "saveFormat": {"const": "safetensors"},
        "testSplitPolicy": {"const": "untouched-until-final-evaluation"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
