# Local ML dataset inputs (schema remains tracked)
ml/evaluation/inputs/*
!ml/evaluation/inputs/schema.json
ml/evaluation/preprocessed/*
!ml/evaluation/preprocessed/schema.json
ml/evaluation/predictions/*
!ml/evaluation/predictions/schema.json
ml/evaluation/finetuning/runs/
ml/evaluation/comparisons/reports/

# Local ML model weights and caches (contracts remain tracked)
ml/evaluation/models/artifacts/
ml/evaluation/models/cache/
ml/evaluation/models/**/*.safetensors
ml/evaluation/models/**/*.onnx
ml/evaluation/models/**/*.bin
ml/evaluation/models/**/*.pt
ml/evaluation/models/**/*.pth

