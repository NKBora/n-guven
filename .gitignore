.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log
terraform.tfplan

# Kubernetes secrets
**/secret.yaml
**/secrets.yaml
**/*-secret.yaml
**/*-secrets.yaml

# Certificates and private keys
*.pem
*.key
*.p12
*.pfx

# .NET
**/bin/
**/obj/
*.user
*.suo

# Node / Vue
**/node_modules/
**/dist/
*.local

# Python
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
