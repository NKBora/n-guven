{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nguven:schema:text-model-release:v1",
  "title": "N-Güven Text Model Release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "stage",
    "model",
    "calibration",
    "thresholds",
    "selection",
    "artifactLayout",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "releaseId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "stage": {"const": "prototype"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterId",
        "modelId",
        "seed",
        "manifestSha256",
        "weightsSha256",
        "weightsSizeBytes",
        "artifactFormat"
      ],
      "properties": {
        "adapterId": {"const": "berturk"},
        "modelId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "seed": {"type": "integer", "minimum": 0},
        "manifestSha256": {"$ref": "#/$defs/sha256"},
        "weightsSha256": {"$ref": "#/$defs/sha256"},
        "weightsSizeBytes": {"type": "integer", "minimum": 1},
        "artifactFormat": {"const": "safetensors"}
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "fittedSplit",
        "temperature",
        "artifactSha256",
        "validationManifestSha256",
        "validationPredictionsSha256"
      ],
      "properties": {
        "method": {"const": "temperature-scaling"},
        "fittedSplit": {"const": "validation"},
        "temperature": {"type": "number", "minimum": 0.05, "maximum": 10},
        "artifactSha256": {"$ref": "#/$defs/sha256"},
        "validationManifestSha256": {"$ref": "#/$defs/sha256"},
        "validationPredictionsSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "lowMaximum", "highMinimum"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "lowMaximum": {"type": "number", "minimum": 0, "maximum": 0.5},
        "highMinimum": {"type": "number", "exclusiveMinimum": 0.5, "maximum": 1}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "validationMacroF1",
        "trainingEvidenceSha256",
        "decisionArtifactSha256",
        "testSplitUsed"
      ],
      "properties": {
        "policy": {"const": "validation-macro-f1-desc-seed-asc-v1"},
        "validationMacroF1": {"type": "number", "minimum": 0, "maximum": 1},
        "trainingEvidenceSha256": {"$ref": "#/$defs/sha256"},
        "decisionArtifactSha256": {"$ref": "#/$defs/sha256"},
        "testSplitUsed": {"const": false}
      }
    },
    "artifactLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelManifest", "calibration"],
      "properties": {
        "modelManifest": {"const": "model-manifest.json"},
        "calibration": {"const": "calibration.json"}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 20, "maxLength": 500}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
